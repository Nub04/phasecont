#!/usr/bin/env bash
# Profile the recursive-call CUDA kernels with Nsight Compute and Nsight Systems (P44 stage 4e).
#
# usage: scripts/nsight-recursion --out DIR [--cli PATH] [--members N] [--launches K]
#                                 [--precision single|double] [--case NAME,NAME,...] [--no-nsys]
#
# Each case is one of our own models run as an RK4 ensemble on CUDA device 0, with t from 0 to
# 0.05 and dt 0.01. The depth of the recursion is set per member, either the same for every
# member or spread from 0 to 4,095 (the kernel stack holds 4,096 frames), so the reports show
# what a spread of depths inside one warp costs. The cases:
#
#   base-equal   x' = -x, no calls (the call-free baseline)
#   sum-equal    s(m) = 1 + s(m-1), depth 2,048 for every member
#   sum-sorted   depth floor(4096 i / N) for member i, so a warp holds nearly equal depths
#   sum-random   depth from a hash of i, uniform on 0 to 4,095
#   pw-equal     pw(a, m) = a pw(a, m-1) with a the state, depth 2,048
#   pw-random    the same with hashed depths
#   fib-equal    fib(m) = fib(m-1) + fib(m-2), m = 10 (177 calls a right-hand side)
#   fib-random   m from a hash of i, uniform on 0 to 12
#
# For every case the script first runs the job without a profiler and checks that each member
# ends with status ok. Then Nsight Compute profiles the first K launches of the pc_ kernels
# (default 4) and Nsight Systems records the whole run. The reports, the models, the jobs and a
# summary.tsv go into DIR. The summary holds, per case, the mean over the profiled launches of
# the branch uniformity, divergent branches, active threads per instruction, registers, active
# warps, local-memory load bytes and DRAM throughput, the global-memory sectors per request
# for loads and for stores (8 for a coalesced warp of doubles, 4 of floats, 32 when every
# thread touches its own sector), the Nsight Compute kernel time, and the total kernel and copy
# times from Nsight Systems. Quote times from Nsight Systems: Nsight Compute replays each launch
# and its times can be off by 2x. DIR should be outside the repository. The CLI is taken from
# --cli, then $PC_CLI, then target/release/pc-cli.
#
# Exit status: 0 when every case ran, 1 when a case failed, 2 on a usage error.

set -u

out=""
cli=""
members=16384
launches=4
precision=double
cases="base-equal,sum-equal,sum-sorted,sum-random,pw-equal,pw-random,fib-equal,fib-random"
nsys_on=1
while [ $# -gt 0 ]; do
  case "$1" in
    --out) out="${2:-}"; shift 2 ;;
    --cli) cli="${2:-}"; shift 2 ;;
    --members) members="${2:-}"; shift 2 ;;
    --launches) launches="${2:-}"; shift 2 ;;
    --precision) precision="${2:-}"; shift 2 ;;
    --case) cases="${2:-}"; shift 2 ;;
    --no-nsys) nsys_on=0; shift ;;
    -h|--help) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "nsight-recursion: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$out" ]; then echo "nsight-recursion: --out DIR is required" >&2; exit 2; fi
case "$precision" in single|double) ;; *) echo "nsight-recursion: precision must be single or double" >&2; exit 2 ;; esac
case "$members" in ''|*[!0-9]*) echo "nsight-recursion: --members must be a whole number" >&2; exit 2 ;; esac
case "$launches" in ''|*[!0-9]*) echo "nsight-recursion: --launches must be a whole number" >&2; exit 2 ;; esac

root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "$cli" ] && [ -n "${PC_CLI:-}" ]; then cli="$PC_CLI"; fi
if [ -z "$cli" ]; then cli="$root/target/release/pc-cli"; fi
if [ ! -x "$cli" ]; then
  echo "nsight-recursion: no pc-cli at $cli. Build it with 'cargo build --release -p pc-cli'." >&2
  exit 2
fi
for tool in ncu jq; do
  command -v "$tool" >/dev/null 2>&1 || { echo "nsight-recursion: $tool is not on PATH" >&2; exit 2; }
done
if [ "$nsys_on" = 1 ]; then
  command -v nsys >/dev/null 2>&1 || { echo "nsight-recursion: nsys is not on PATH (or pass --no-nsys)" >&2; exit 2; }
fi
mkdir -p "$out" || exit 2
out="$(cd "$out" && pwd)"

metrics="smsp__sass_average_branch_targets_threads_uniform.pct"
metrics="$metrics,smsp__sass_branch_targets_threads_divergent.sum"
metrics="$metrics,smsp__thread_inst_executed_per_inst_executed.ratio"
metrics="$metrics,launch__registers_per_thread"
metrics="$metrics,sm__warps_active.avg.pct_of_peak_sustained_active"
metrics="$metrics,l1tex__t_bytes_pipe_lsu_mem_local_op_ld.sum"
metrics="$metrics,l1tex__t_sectors_pipe_lsu_mem_global_op_ld.sum"
metrics="$metrics,l1tex__t_requests_pipe_lsu_mem_global_op_ld.sum"
metrics="$metrics,l1tex__t_sectors_pipe_lsu_mem_global_op_st.sum"
metrics="$metrics,l1tex__t_requests_pipe_lsu_mem_global_op_st.sum"
metrics="$metrics,dram__throughput.avg.pct_of_peak_sustained_elapsed"
metrics="$metrics,gpu__time_duration.sum"

# The model of a case and the start state of every member.
model() {
  case "$1" in
    base) printf 'x'"'"'=-x\ndone\n' ;;
    sum) printf 'par n=0\ns(m)=if(m<1)then(0)else(1+s(m-1))\nx'"'"'=-x*(1+s(n))/(1+n)\ndone\n' ;;
    pw) printf 'par n=0\npw(a,m)=if(m<1)then(1)else(a*pw(a,m-1))\nx'"'"'=-0.01*pw(x,n)\ndone\n' ;;
    fib) printf 'par n=0\nfib(m)=if(m<2)then(m)else(fib(m-1)+fib(m-2))\nx'"'"'=-x*fib(n)/(1+fib(n))\ndone\n' ;;
  esac
}

# Writes the job of a case. The depth rule is equal, sorted or random; random takes a
# multiplicative hash of the member index, so every run gets the same depths.
job() {
  local name="$1" rule="$2" equal="$3" span="$4" x0="$5"
  awk -v N="$members" -v rule="$rule" -v eq="$equal" -v span="$span" -v x0="$x0" \
      -v prec="$precision" -v name="$name" 'BEGIN {
    printf "{\"backend\":\"cuda\",\"precision\":\"%s\",\"t0\":0,\"t1\":0.05,", prec
    printf "\"method\":{\"type\":\"rk4\",\"dt\":0.01},\"output\":\"final\",\"bounds\":null,"
    printf "\"max_steps\":100,\"x0\":["
    for (i = 0; i < N; i++) printf "%s[%s]", (i ? "," : ""), x0
    printf "],\"params\":"
    if (name == "base") { printf "{\"shared\":[]}}\n"; exit }
    printf "{\"per_member\":["
    for (i = 0; i < N; i++) {
      if (rule == "equal") d = eq
      else if (rule == "sorted") d = int(i * span / N)
      else d = int(((i * 2654435761) % 4294967296) / 4294967296 * span)
      printf "%s[%d]", (i ? "," : ""), d
    }
    printf "]}}\n"
  }'
}

fail=0
summary="$out/summary.tsv"
printf 'case\tbranch_uniform_pct\tdivergent_branches\tthreads_per_inst\tregisters\twarps_active_pct\tlocal_load_bytes\tld_sectors_per_request\tst_sectors_per_request\tdram_pct\tkernel_ns\tlaunches\tnsys_kernel_ns\tnsys_memcpy_ns\n' > "$summary"

IFS=',' read -r -a list <<< "$cases"
for c in "${list[@]}"; do
  kind="${c%%-*}"; rule="${c#*-}"
  case "$kind" in
    base) equal=0; span=0; x0=1 ;;
    sum|pw) equal=2048; span=4096; x0=1; [ "$kind" = pw ] && x0=0.999 ;;
    fib) equal=10; span=13; x0=1 ;;
    *) echo "nsight-recursion: unknown case $c" >&2; exit 2 ;;
  esac
  case "$rule" in equal|sorted|random) ;; *) echo "nsight-recursion: unknown case $c" >&2; exit 2 ;; esac
  tag="$c-$precision"
  model "$kind" > "$out/$kind.ode"
  job "$kind" "$rule" "$equal" "$span" "$x0" > "$out/$tag.json"

  echo "== $tag: plain run" >&2
  if ! "$cli" ensemble "$out/$kind.ode" "$out/$tag.json" > "$out/$tag.result.json" 2> "$out/$tag.stderr"; then
    echo "nsight-recursion: $tag failed:" >&2; cat "$out/$tag.stderr" >&2; fail=1; continue
  fi
  bad="$(jq '[.status[] | select(. != "ok")] | length' "$out/$tag.result.json")"
  if [ "$bad" != 0 ]; then
    echo "nsight-recursion: $tag: $bad members did not end ok" >&2; fail=1; continue
  fi

  echo "== $tag: Nsight Compute" >&2
  if ! ncu --kernel-name regex:pc_ --launch-count "$launches" --metrics "$metrics" \
        --force-overwrite -o "$out/$tag" \
        "$cli" ensemble "$out/$kind.ode" "$out/$tag.json" > /dev/null 2> "$out/$tag.ncu.log"; then
    echo "nsight-recursion: ncu failed on $tag, see $out/$tag.ncu.log" >&2; fail=1; continue
  fi
  # Nsight Compute 2026 writes a compressed .ncu-repz; older releases write .ncu-rep.
  rep="$out/$tag.ncu-repz"; [ -f "$rep" ] || rep="$out/$tag.ncu-rep"
  ncu --import "$rep" --csv --page raw --print-units base > "$out/$tag.ncu.csv" 2>> "$out/$tag.ncu.log"

  ks="-"; ms="-"
  if [ "$nsys_on" = 1 ]; then
    echo "== $tag: Nsight Systems" >&2
    if nsys profile --trace=cuda --force-overwrite=true -o "$out/$tag" \
         "$cli" ensemble "$out/$kind.ode" "$out/$tag.json" > /dev/null 2> "$out/$tag.nsys.log"; then
      nsys stats --report cuda_gpu_kern_sum,cuda_gpu_mem_time_sum --format csv \
        --force-export=true "$out/$tag.nsys-rep" > "$out/$tag.nsys.csv" 2>> "$out/$tag.nsys.log"
      # Each report starts with a header line that names its "Total Time (ns)" column.
      read -r ks ms < <(awk -v FPAT='([^,]*)|("[^"]*")' '
        /Total Time \(ns\)/ { sec++; for (i = 1; i <= NF; i++) if ($i ~ /Total Time/) col = i; next }
        sec && NF > 1 && $col ~ /^"?[0-9]/ { v = $col; gsub(/[",]/, "", v); tot[sec] += v }
        END { printf "%d %d\n", tot[1], tot[2] }' "$out/$tag.nsys.csv")
    else
      echo "nsight-recursion: nsys failed on $tag, see $out/$tag.nsys.log" >&2; fail=1
    fi
  fi

  # The raw page has a header row, a units row, then one row per launch.
  awk -v FPAT='([^,]*)|("[^"]*")' -v tag="$c" -v ks="$ks" -v ms="$ms" '
    function clean(s) { gsub(/[",]/, "", s); return s }
    NR == 1 { for (i = 1; i <= NF; i++) col[clean($i)] = i; next }
    NR == 2 { next }
    {
      n++
      for (k in want) sum[k] += clean($col[want[k]])
    }
    BEGIN {
      want[1] = "smsp__sass_average_branch_targets_threads_uniform.pct"
      want[2] = "smsp__sass_branch_targets_threads_divergent.sum"
      want[3] = "smsp__thread_inst_executed_per_inst_executed.ratio"
      want[4] = "launch__registers_per_thread"
      want[5] = "sm__warps_active.avg.pct_of_peak_sustained_active"
      want[6] = "l1tex__t_bytes_pipe_lsu_mem_local_op_ld.sum"
      want[7] = "gpu__time_duration.sum"
      want[8] = "l1tex__t_sectors_pipe_lsu_mem_global_op_ld.sum"
      want[9] = "l1tex__t_requests_pipe_lsu_mem_global_op_ld.sum"
      want[10] = "dram__throughput.avg.pct_of_peak_sustained_elapsed"
      want[11] = "l1tex__t_sectors_pipe_lsu_mem_global_op_st.sum"
      want[12] = "l1tex__t_requests_pipe_lsu_mem_global_op_st.sum"
    }
    END {
      if (!n) { printf "%s\t-\t-\t-\t-\t-\t-\t-\t-\t-\t-\t0\t%s\t%s\n", tag, ks, ms; exit }
      spr = sum[9] ? sum[8] / sum[9] : 0
      sps = sum[12] ? sum[11] / sum[12] : 0
      printf "%s\t%.2f\t%.0f\t%.2f\t%.0f\t%.1f\t%.0f\t%.2f\t%.2f\t%.1f\t%.0f\t%d\t%s\t%s\n", tag,
        sum[1] / n, sum[2] / n, sum[3] / n, sum[4] / n, sum[5] / n, sum[6] / n, spr, sps, sum[10] / n,
        sum[7] / n, n, ks, ms
    }' "$out/$tag.ncu.csv" >> "$summary"
done

column -t -s "$(printf '\t')" "$summary"
exit "$fail"
