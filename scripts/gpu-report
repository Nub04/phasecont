#!/usr/bin/env bash
# Run the PhaseCont GPU self-test on every device the engine finds and write one report file.
#
# usage: scripts/gpu-report [--cli PATH] [--out FILE]
#
# The CLI is taken from --cli, then $PC_CLI, then target/release/pc-cli, then target/debug/pc-cli,
# then pc-cli on PATH. The report is plain text with fenced blocks, ready to paste into an issue.
# It holds the device names, driver strings, the OS name and the self-test output. It does not
# hold your user name, host name or file paths.
#
# Exit status: 0 when every self-test that ran passed (devices with no driver are listed, not
# counted), 1 when a self-test failed, 2 when the CLI is missing or cannot list devices.
# Written for bash 3.2 so that it runs on a stock macOS.

set -u

cli=""
out=""
while [ $# -gt 0 ]; do
  case "$1" in
    --cli) cli="${2:-}"; shift 2 ;;
    --out) out="${2:-}"; shift 2 ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "gpu-report: unknown argument: $1" >&2; exit 2 ;;
  esac
done

root="$(cd "$(dirname "$0")/.." && pwd)"
if [ -z "$cli" ] && [ -n "${PC_CLI:-}" ]; then cli="$PC_CLI"; fi
if [ -z "$cli" ]; then
  for c in "$root/target/release/pc-cli" "$root/target/debug/pc-cli"; do
    if [ -x "$c" ]; then cli="$c"; break; fi
  done
fi
if [ -z "$cli" ] && command -v pc-cli >/dev/null 2>&1; then cli="$(command -v pc-cli)"; fi
if [ -z "$cli" ] || [ ! -x "$cli" ]; then
  echo "gpu-report: no pc-cli found. Build it with 'cargo build --release -p pc-cli' or pass --cli." >&2
  exit 2
fi

if [ -z "$out" ]; then out="gpu-report-$(date +%Y%m%d-%H%M%S).txt"; fi

tmp="$(mktemp -d "${TMPDIR:-/tmp}/gpu-report.XXXXXX")" || exit 2
trap 'rm -rf "$tmp"' EXIT

if ! "$cli" gpu list > "$tmp/list.json" 2> "$tmp/list.err"; then
  echo "gpu-report: 'pc-cli gpu list' failed:" >&2
  cat "$tmp/list.err" >&2
  exit 2
fi

# The list is pretty-printed JSON with the keys of each object in alphabetical order, so "backend"
# comes first and "index" after "fp64". Collect one "backend index fp64" line per non-CPU device.
awk '
  /"devices"[[:space:]]*:/ { in_dev = 1 }
  !in_dev { next }
  /"backend"[[:space:]]*:/ { b = $0; sub(/.*"backend"[[:space:]]*:[[:space:]]*"/, "", b); sub(/".*/, "", b) }
  /"fp64"[[:space:]]*:/    { f = ($0 ~ /true/) ? "true" : "false" }
  /"index"[[:space:]]*:/   {
    i = $0; sub(/.*"index"[[:space:]]*:[[:space:]]*/, "", i); sub(/[^0-9].*/, "", i)
    if (b != "cpu" && b != "") print b, i, f
  }
' "$tmp/list.json" > "$tmp/devices.txt"

{
  echo "PhaseCont GPU report"
  echo "date: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "os: $(uname -srm)"
  if command -v git >/dev/null 2>&1 && git -C "$root" rev-parse --short HEAD >/dev/null 2>&1; then
    echo "commit: $(git -C "$root" rev-parse --short HEAD)"
  fi
  echo "cli: $("$cli" --version 2>/dev/null || echo unknown)"
  echo
  echo "== pc-cli gpu list =="
  echo '```json'
  cat "$tmp/list.json"
  echo '```'
} > "$out"

failed=0
ran=0
summary="$tmp/summary.txt"
: > "$summary"
n=0

if [ ! -s "$tmp/devices.txt" ]; then
  echo "no GPU device found (see the backend states above)" >> "$summary"
fi

while read -r backend index fp64; do
  [ -n "$backend" ] || continue
  precisions="single"
  if [ "$fp64" = "true" ]; then precisions="single double"; fi
  for p in $precisions; do
    n=$((n + 1))
    "$cli" gpu selftest --backend "$backend" --device "$index" --precision "$p" \
      < /dev/null > "$tmp/st-$n.json" 2> "$tmp/st-$n.err"
    code=$?
    case "$code" in
      0) verdict="pass"; ran=$((ran + 1)) ;;
      1) verdict="FAIL"; ran=$((ran + 1)); failed=1 ;;
      3) verdict="missing" ;;
      *) verdict="error($code)"; failed=1 ;;
    esac
    printf '%-8s device %-2s %-7s %s\n' "$backend" "$index" "$p" "$verdict" >> "$summary"
    {
      echo
      echo "== pc-cli gpu selftest --backend $backend --device $index --precision $p (exit $code) =="
      echo '```json'
      cat "$tmp/st-$n.json"
      echo '```'
      if [ -s "$tmp/st-$n.err" ]; then
        echo "stderr:"
        echo '```'
        cat "$tmp/st-$n.err"
        echo '```'
      fi
    } >> "$out"
  done
done < "$tmp/devices.txt"

{
  echo
  echo "== summary =="
  cat "$summary"
} >> "$out"

echo "gpu-report: wrote $out"
cat "$summary"
if [ "$failed" -ne 0 ]; then exit 1; fi
exit 0
