# Passive cable in 20 compartments with sealed ends, after Rall (1959) and Dayan and Abbott, Theoretical Neuroscience (2001), chapter 6. Illustrative values.
par tau=10,D=2,Iin=1
v1'=(-v1+D*(v2-v1)+Iin)/tau
v[2..19]'=(-v[j]+D*(v[j-1]-2*v[j]+v[j+1]))/tau
v20'=(-v20+D*(v19-v20))/tau
v[1..20](0)=0
@ total=100,xp=t,yp=v20
done
