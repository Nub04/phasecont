# The torus bifurcation of cyc_ns after the nonlinear change of coordinates
# u1 = x1 + 0.3 (x2^2 - y2^2), which leaves the cycle (w = 0) and its linearization alone but
# adds quadratic terms along the cycle direction, so the second harmonic h20 is nonzero.
# Re d does not change: Re d = -2/pi. Own test model.
par beta=0.2
Om=2
lam=beta-0.25
x1=u1-0.3*(x2^2-y2^2)
r2=x2^2+y2^2
f1=beta*x1-Om*y1-(x1^2+y1^2)*x1
g1=beta*y1+Om*x1-(x1^2+y1^2)*y1
f2=lam*x2-0.8*y2-r2*(x2-0.5*y2)
g2=lam*y2+0.8*x2-r2*(y2+0.5*x2)
u1'=f1+0.3*(2*x2*f2-2*y2*g2)
y1'=g1
x2'=f2
y2'=g2
init u1=0.45,y1=0,x2=0,y2=0
done
