# Planar Hopf block plus 28 slow decoupled modes (n = 30). The 378 pairs of slow
# modes each give a psi_H factor near 2e-3, far below the f64 range when multiplied.
par al=-0.5
x'=al*x-y-x*(x^2+y^2)
y'=x+al*y-y*(x^2+y^2)
z1'=-0.00101*z1
z2'=-0.00102*z2
z3'=-0.00103*z3
z4'=-0.00104*z4
z5'=-0.00105*z5
z6'=-0.00106*z6
z7'=-0.00107*z7
z8'=-0.00108*z8
z9'=-0.00109*z9
z10'=-0.00110*z10
z11'=-0.00111*z11
z12'=-0.00112*z12
z13'=-0.00113*z13
z14'=-0.00114*z14
z15'=-0.00115*z15
z16'=-0.00116*z16
z17'=-0.00117*z17
z18'=-0.00118*z18
z19'=-0.00119*z19
z20'=-0.00120*z20
z21'=-0.00121*z21
z22'=-0.00122*z22
z23'=-0.00123*z23
z24'=-0.00124*z24
z25'=-0.00125*z25
z26'=-0.00126*z26
z27'=-0.00127*z27
z28'=-0.00128*z28
init x=0,y=0
done
