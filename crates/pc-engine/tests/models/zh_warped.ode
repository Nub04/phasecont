# zh.ode after the triangular change U = x, V = y + wa x^2, W = z + wb x y + wg x^3, so
# x = U, y = V - wa U^2, z = W - wb U y - wg U^3. The linear part at the origin is
# unchanged and the second-order terms of V' and W' are not zero, so the normal form
# vectors h are not zero. b, c, Re d and e are invariants of the zero-Hopf point.
par b1=0,b2=0,B=1.5,C=0.8,K=0.3,L=0.6,om=2,dr=1,di=0.4,er=0.5,ei=-0.3,mr=-0.4,mi=0.7,wa=0.4,wb=-0.3,wg=0.2
px=U
py=V-wa*U^2
pz=W-wb*U*py-wg*U^3
rr=py^2+pz^2
al=b2+dr*px+er*px^2+mr*rr
be=om+di*px+ei*px^2+mi*rr
fx=b1+B*px^2+C*rr+K*px^3+L*px*rr
fy=al*py-be*pz
fz=al*pz+be*py
U'=fx
V'=fy+2*wa*px*fx
W'=fz+wb*(fx*py+px*fy)+3*wg*px^2*fx
init U=0,V=0,W=0
done
