# hh.ode in the coordinates u = R v, with R = G4 G3 G2 G1 a product of four Givens rotations
# in the planes (1,3), (2,4), (1,4) and (2,3) with angles g1 to g4. R is orthogonal, so the
# normal form coefficients with |q| = 1 do not change.
par b1=0,b2=0,om1=2,om2=0.9,a11r=-0.8,a11i=0.3,a12r=1.7,a12i=-0.4,a21r=0.6,a21i=0.5,a22r=-1.1,a22i=0.2,g1=0.7,g2=-0.5,g3=1.1,g4=0.4
ca1=cos(g1)
sa1=sin(g1)
ca2=cos(g2)
sa2=sin(g2)
ca3=cos(g3)
sa3=sin(g3)
ca4=cos(g4)
sa4=sin(g4)
# v = G1' G2' G3' G4' u
w1=u1
w2=ca4*u2+sa4*u3
w3=-sa4*u2+ca4*u3
w4=u4
z1=ca3*w1+sa3*w4
z2=w2
z3=w3
z4=-sa3*w1+ca3*w4
d1=z1
d2=ca2*z2+sa2*z4
d3=z3
d4=-sa2*z2+ca2*z4
v1=ca1*d1+sa1*d3
v2=d2
v3=-sa1*d1+ca1*d3
v4=d4
r1=v1^2+v2^2
r2=v3^2+v4^2
al1=b1+a11r*r1+a12r*r2
be1=om1+a11i*r1+a12i*r2
al2=b2+a21r*r1+a22r*r2
be2=om2+a21i*r1+a22i*r2
f1=al1*v1-be1*v2
f2=al1*v2+be1*v1
f3=al2*v3-be2*v4
f4=al2*v4+be2*v3
# u' = G4 G3 G2 G1 f
h1=ca1*f1-sa1*f3
h2=f2
h3=sa1*f1+ca1*f3
h4=f4
k1=h1
k2=ca2*h2-sa2*h4
k3=h3
k4=sa2*h2+ca2*h4
m1=ca3*k1-sa3*k4
m2=k2
m3=k3
m4=sa3*k1+ca3*k4
u1'=m1
u2'=ca4*m2-sa4*m3
u3'=sa4*m2+ca4*m3
u4'=m4
init u1=0,u2=0,u3=0,u4=0
