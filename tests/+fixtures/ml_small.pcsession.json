    "sha256": "47cf08eefec873a8b4ccff58a846f5950a1d2d50b36caa7e2f216b0b03d8de1e",
    "source": "# Morris-Lecar model with the type II parameter set of crates/pc-ode/tests/corpus,\n# with I and phi first so that they are parameters 0 and 1. The rest state loses\n# stability in a Hopf point and the stable cycle ends in a fold of cycles below it.\npar I=100,phi=0.04\npar C=20,gL=2,gK=8,gCa=4.4\npar vL=-60,vK=-84,vCa=120\npar v1=-1.2,v2=18,v3=2,v4=30\nminf=0.5*(1+tanh((v-v1)/v2))\nwinf=0.5*(1+tanh((v-v3)/v4))\ntauw=1/cosh((v-v3)/(2*v4))\nv'=(I-gL*(v-vL)-gK*w*(v-vK)-gCa*minf*(v-vCa))/C\nw'=phi*(winf-w)/tauw\ninit v=-20,w=0.1\ndone\n"
  },
